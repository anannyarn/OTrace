# OTrace Environment Configuration

# Optional Search API Key for Social & Web profile discovery (Brave Search API or Tavily API)
# Get a free key at https://brave.com/search/api/ or https://tavily.com/
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional Anthropic API key for top 5 candidates LLM verification
ANTHROPIC_API_KEY=

# Database & Cache settings
DATABASE_URL=sqlite:///./otrace.db
CACHE_TTL_HOURS=24
